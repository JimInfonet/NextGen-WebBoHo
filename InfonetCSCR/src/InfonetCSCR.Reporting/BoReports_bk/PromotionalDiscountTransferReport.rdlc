                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
    Fields!Day.Value &gt;= 1 AND Fields!Day.Value &lt;= 7, 
    WEEKDAYNAME(
        IIF(Fields!Day.Value &gt;=1 AND Fields!Day.Value &lt;=7, Fields!Day.Value, 1)
        )
    , ""
    )</Value>
                                  <Style />
                                </TextRun>
