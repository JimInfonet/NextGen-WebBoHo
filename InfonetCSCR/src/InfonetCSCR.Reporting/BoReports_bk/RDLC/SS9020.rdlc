  <Code>Public Function GetReportString(ph as Integer) as String
  Try
    Return InfonetWebReporting.Service.LocalizedValue.GetLocalizedString(ph)
  Catch ex As Exception
    Return ex.Message
  End Try
End Function
</Code>
