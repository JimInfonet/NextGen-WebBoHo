                </TablixCells></TablixRow>
                <TablixRow><Height>0.23in</Height><TablixCells>
                  <TablixCell><CellContents><Textbox Name="StoreValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Price_Number.Value</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="StockCodeValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!STOCK_CODE.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="DescriptionValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DESCRIPT.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="VendorValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!Name.Value), Fields!VendorID.Value, Fields!VendorID.Value &amp; &quot; - &quot; &amp; Fields!Name.Value)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="PriceValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!OrderNo.Value), &quot;Current Price&quot;, IIf(Fields!OrderNo.Value = 0, IIf(IsNothing(Fields!StoreID.Value), &quot;Current Price&quot;, &quot;Exceptional Price for Store &quot; &amp; Fields!StoreID.Value), &quot;Future Price &quot; &amp; Fields!OrderNo.Value))</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="OrderValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Price.Value</Value><Style><Format>n2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="StartValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!StartDate.Value</Value><Style><Format>d</Format></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
                  <TablixCell><CellContents><Textbox Name="EndValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!EndDate.Value</Value><Style><Format>d</Format></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
