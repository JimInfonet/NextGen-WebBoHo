          </TablixCells></TablixRow>
          <TablixRow><Height>0.28in</Height><TablixCells>
            <TablixCell><CellContents><Textbox Name="Stock"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!STOCK_CODE.Value &amp; " - " &amp; Fields!DESCRIPT.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="Department"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!DEPT.Value &amp; " - " &amp; Fields!DEPT_NAME.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="SubDepartment"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!SUB_DEPT.Value &amp; " - " &amp; Fields!SUB_NAME.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="SubDetail"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Sub_Detail.Value &amp; " - " &amp; Fields!SubDetail_Name.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="Vendor"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Vendor.Value &amp; IIF(Fields!VendorName.Value = "", "", " - " &amp; Fields!VendorName.Value)</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="Category"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!STOCK_TYPE.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="Cost"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!STD_COST.Value</Value><Style><FontSize>8pt</FontSize><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="Price"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Price.Value</Value><Style><FontSize>8pt</FontSize><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="Margin"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Margin.Value</Value><Style><FontSize>8pt</FontSize><Format>P2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="TaxInfo"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Tax_Code.Value &amp; " - " &amp; Fields!Tax_Name.Value &amp; " " &amp; Format(Fields!TAX_RATE.Value, "0.##") &amp; "%"</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          </TablixCells></TablixRow>
        </TablixRows>
