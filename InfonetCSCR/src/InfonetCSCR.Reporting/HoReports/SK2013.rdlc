            <TablixCell><CellContents><Textbox Name="CategoryHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Category</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
            <TablixCell><CellContents><Textbox Name="CostHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Cost</Value><Style><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
