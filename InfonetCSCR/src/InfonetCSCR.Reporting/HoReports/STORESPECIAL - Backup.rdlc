  <DataSets><DataSet Name="StoreS"><Query><DataSourceName>CSCTransDataSet</DataSourceName><CommandText>/* Local Query */</CommandText></Query><Fields>
    <Field Name="STOCK_CODE"><DataField>STOCK_CODE</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="DESCRIPT"><DataField>DESCRIPT</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="StoreID"><DataField>StoreID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="VendorID"><DataField>VendorID</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Name"><DataField>Name</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Pr_Type"><DataField>Pr_Type</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="Pr_Units"><DataField>Pr_Units</DataField><rd:TypeName>System.String</rd:TypeName></Field><Field Name="StartDate"><DataField>StartDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="EndDate"><DataField>EndDate</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field><Field Name="PRICE"><DataField>PRICE</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field><Field Name="OrderNo"><DataField>OrderNo</DataField><rd:TypeName>System.Int16</rd:TypeName></Field>
  </Fields></DataSet></DataSets>
  <ReportSections><ReportSection><Body><ReportItems>
    <Textbox Name="CompanyName"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!company.Value</Value><Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>CompanyName</rd:DefaultName><Top>0.08in</Top><Left>0.1in</Left><Height>0.23in</Height><Width>5.5in</Width><Style><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
    <Textbox Name="ReportTitle"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Parameters!reportTitle.Value</Value><Style><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>ReportTitle</rd:DefaultName><Top>0.34in</Top><Left>0.1in</Left><Height>0.28in</Height><Width>7.8in</Width><Style><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
    <Textbox Name="StoreFilter"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=&quot;Store: &quot; &amp; Parameters!store.Value</Value><Style><FontSize>9pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><rd:DefaultName>StoreFilter</rd:DefaultName><Top>0.65in</Top><Left>0.1in</Left><Height>0.18in</Height><Width>4in</Width><Style><PaddingLeft>2pt</PaddingLeft></Style></Textbox>
    <Tablix Name="StoreSpecialTablix"><TablixBody><TablixColumns><TablixColumn><Width>2.45in</Width></TablixColumn><TablixColumn><Width>1.45in</Width></TablixColumn><TablixColumn><Width>1.15in</Width></TablixColumn><TablixColumn><Width>1.35in</Width></TablixColumn><TablixColumn><Width>1.7in</Width></TablixColumn></TablixColumns><TablixRows>
      <TablixRow><Height>0.25in</Height><TablixCells>
        <TablixCell><CellContents><Textbox Name="HeaderProduct"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Product ID / Description</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="HeaderVendor"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Vendor ID / Name</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="HeaderType"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Price Type / Unit</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="HeaderDates"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Start Date / End Date</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="HeaderPrice"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Price / Status</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      </TablixCells></TablixRow>
      <TablixRow><Height>0.25in</Height><TablixCells>
        <TablixCell><CellContents><Textbox Name="ProductValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!STOCK_CODE.Value &amp; &quot; - &quot; &amp; Fields!DESCRIPT.Value</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="VendorValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIf(IsNothing(Fields!Name.Value), Fields!VendorID.Value, Fields!VendorID.Value &amp; &quot; - &quot; &amp; Fields!Name.Value)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="TypeValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!Pr_Type.Value &amp; &quot; / &quot; &amp; Fields!Pr_Units.Value</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="DatesValue"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!StartDate.Value, &quot;d&quot;) &amp; &quot; - &quot; &amp; Format(Fields!EndDate.Value, &quot;d&quot;)</Value><Style /></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
        <TablixCell><CellContents><Textbox Name="PriceValue"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Format(Fields!PRICE.Value, &quot;n2&quot;) &amp; &quot; - &quot; &amp; IIf(IsNothing(Fields!OrderNo.Value), &quot;Current Price&quot;, IIf(Fields!OrderNo.Value = 0, IIf(IsNothing(Fields!StoreID.Value), &quot;Current Price&quot;, &quot;Exceptional Price for Store &quot; &amp; Fields!StoreID.Value), &quot;Future Price &quot; &amp; Fields!OrderNo.Value))</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      </TablixCells></TablixRow>
    </TablixRows></TablixBody><TablixColumnHierarchy><TablixMembers><TablixMember /><TablixMember /><TablixMember /><TablixMember /><TablixMember /></TablixMembers></TablixColumnHierarchy><TablixRowHierarchy><TablixMembers><TablixMember><KeepWithGroup>After</KeepWithGroup><RepeatOnNewPage>true</RepeatOnNewPage></TablixMember><TablixMember><Group Name="Details" /></TablixMember></TablixMembers></TablixRowHierarchy><DataSetName>StoreS</DataSetName><Top>0.95in</Top><Left>0.1in</Left><Height>0.5in</Height><Width>8.1in</Width><Style><Border><Style>None</Style></Border></Style></Tablix>
