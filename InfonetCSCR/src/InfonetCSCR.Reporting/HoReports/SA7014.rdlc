      <TablixCell><CellContents><Textbox Name="DeptHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Dept / Name</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="SubDeptHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sub Dept / Name</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="StockHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Stock Code / Description</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="QtyHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Qty Sold</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="SaleHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Sale Amount</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="CostHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total Cost</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="ProfitHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Total Profit</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="MarginHeader"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Margin %</Value><Style><FontWeight>Bold</FontWeight><Color>White</Color></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>#44546A</BackgroundColor><Border><Color>White</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>3pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
    </TablixCells></TablixRow>
    <TablixRow><Height>0.25in</Height><TablixCells>
      <TablixCell><CellContents><Textbox Name="Dept"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!DEPT.Value) &amp; " - " &amp; First(Fields!DEPT_NAME.Value)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="SubDept"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!SUB_DEPT.Value) &amp; " - " &amp; First(Fields!SUB_NAME.Value)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="Stock"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=First(Fields!STOCK_CODE.Value) &amp; " - " &amp; First(Fields!DESCRIPT.Value)</Value><Style /></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="Qty"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!QUANTITY.Value)</Value><Style><Format>N2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="SaleAmount"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value)</Value><Style><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="TotalCost"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Abs(Fields!QUANTITY.Value) * Fields!COST.Value)</Value><Style><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="TotalProfit"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum((Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value) - (Abs(Fields!QUANTITY.Value) * Fields!COST.Value))</Value><Style><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="Margin"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Sum(Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value) = 0, 0, Sum((Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value) - (Abs(Fields!QUANTITY.Value) * Fields!COST.Value)) / Sum(Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value))</Value><Style><Format>P2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
    </TablixCells></TablixRow>
    <TablixRow><Height>0.28in</Height><TablixCells>
      <TablixCell><CellContents><Textbox Name="GrandTotalLabel"><Paragraphs><Paragraph><TextRuns><TextRun><Value>Report Totals</Value><Style><FontWeight>Bold</FontWeight></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft></Style></Textbox><ColSpan>3</ColSpan></CellContents></TablixCell><TablixCell /><TablixCell />
      <TablixCell><CellContents><Textbox Name="GrandQty"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!QUANTITY.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>N2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Double</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="GrandSale"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Double</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="GrandCost"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum(Abs(Fields!QUANTITY.Value) * Fields!COST.Value)</Value><Style><FontWeight>Bold</FontWeight><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Double</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="GrandProfit"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Sum((Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value) - (Abs(Fields!QUANTITY.Value) * Fields!COST.Value))</Value><Style><FontWeight>Bold</FontWeight><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Double</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
      <TablixCell><CellContents><Textbox Name="GrandMargin"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=IIF(Sum(Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value) = 0, 0, Sum((Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value) - (Abs(Fields!QUANTITY.Value) * Fields!COST.Value)) / Sum(Fields!AMOUNT.Value - Fields!DISCOUNT.Value - Fields!DISC_ADJ.Value))</Value><Style><FontWeight>Bold</FontWeight><Format>P2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Style>Double</Style></Border><PaddingRight>3pt</PaddingRight></Style></Textbox></CellContents></TablixCell>
