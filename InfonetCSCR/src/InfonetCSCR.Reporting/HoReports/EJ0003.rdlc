                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!Qty.Value &lt; 0, "(", "") &amp; IIf(Int(System.Math.Abs(Fields!Qty.Value)) = System.Math.Abs(Fields!Qty.Value), Format(System.Math.Abs(Fields!Qty.Value), "N0"), Format(System.Math.Abs(Fields!Qty.Value), "N2")) &amp; IIf(Fields!Qty.Value &lt; 0, ")", "")</Value>
                                  <Style />
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
