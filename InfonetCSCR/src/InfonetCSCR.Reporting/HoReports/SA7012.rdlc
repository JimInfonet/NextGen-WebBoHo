                      <CellContents>
                        <Textbox Name="AMOUNT">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!AMOUNT.Value-Fields!DISCOUNT.Value-Fields!DISC_ADJ.Value</Value>
                                  <Style>
                                    <Format>'$'0.00;('$'0.00)</Format>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>AMOUNT</rd:DefaultName>
