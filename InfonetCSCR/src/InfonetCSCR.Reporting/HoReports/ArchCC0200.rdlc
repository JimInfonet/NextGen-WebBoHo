        <TablixRow><Height>0.28in</Height><TablixCells>
          <TablixCell><CellContents><Textbox Name="Batch"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!BatchId.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          <TablixCell><CellContents><Textbox Name="Product"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!ProductId.Value &amp; " - " &amp; Fields!Description.Value</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          <TablixCell><CellContents><Textbox Name="StartDate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!StartDate.Value</Value><Style><FontSize>8pt</FontSize><Format>yyyy-MM-dd</Format></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          <TablixCell><CellContents><Textbox Name="EndDate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!EndDate.Value</Value><Style><FontSize>8pt</FontSize><Format>yyyy-MM-dd</Format></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          <TablixCell><CellContents><Textbox Name="CurrentCost"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!OldCost.Value</Value><Style><FontSize>8pt</FontSize><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          <TablixCell><CellContents><Textbox Name="NewCost"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!NewCost.Value</Value><Style><FontSize>8pt</FontSize><Format>C2</Format></Style></TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingRight>3pt</PaddingRight><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
          <TablixCell><CellContents><Textbox Name="Store"><CanGrow>true</CanGrow><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!StoreId.Value &amp; IIF(Fields!StoreDesc.Value = "", "", " - " &amp; Fields!StoreDesc.Value)</Value><Style><FontSize>8pt</FontSize></Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingLeft>3pt</PaddingLeft><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
