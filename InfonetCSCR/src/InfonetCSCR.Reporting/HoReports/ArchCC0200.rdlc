          <TablixCell><CellContents><Textbox Name="TransferDate"><Paragraphs><Paragraph><TextRuns><TextRun><Value>=Fields!TransDate.Value</Value><Style><FontSize>8pt</FontSize><Format>yyyy-MM-dd HH:mm</Format></Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><Border><Color>LightGrey</Color><Style>Solid</Style></Border><PaddingTop>2pt</PaddingTop></Style></Textbox></CellContents></TablixCell>
