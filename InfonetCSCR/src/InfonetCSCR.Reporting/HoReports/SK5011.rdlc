  <Variables>
    <Variable Name="StockDisplay">
      <Value>If STOCKMST.STOCK_TYPE == "F" Then
	KIT_ITEM.STOCK_CODE
ELSE
	StockHist.StockCode</Value>
      <Writable>true</Writable>
    </Variable>
    <Variable Name="DescDisplay">
      <Value>IF STOCKMST.STOCK_TYPE == "F" then
	StockHist.StockCode &amp; " / " &amp; StockHist.Description
else
	StockHist.Description</Value>
    </Variable>
    <Variable Name="KitQty">
      <Value>IF STOCKMST.STOCK_TYPE == "F" THEN
	StockHist.Qty
ELSE
	0</Value>
    </Variable>
    <Variable Name="CntQty">
      <Value>If STOCKMST.STOCK_TYPE == "F" Then
    StockHist.Qty*KIT_ITEM.QUANTITY
ELSE
    StockHist.Qty</Value>
    </Variable>
    <Variable Name="SysQty">
      <Value>If STOCKMST.STOCK_TYPE == "F" Then
    StockHist.BookQty
ELSE
    0</Value>
    </Variable>
    <Variable Name="CostDisplay">
      <Value>IF STOCKMST.STOCK_TYPE != "F" Then  
    StockHist.Cost</Value>
    </Variable>
    <Variable Name="QtyDiff">
      <Value>If STOCKMST.STOCK_TYPE == "F" Then
    StockHist.Qty*KIT_ITEM.QUANTITY - StockHist.BookQty
ELSE
    StockHist.Qty</Value>
    </Variable>
    <Variable Name="AmtDiff">
      <Value>IF STOCKMST.STOCK_TYPE != "F" Then
	Fields!Cost.Value * Variables!QtyDiff.Value</Value>
    </Variable>
  </Variables>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>
