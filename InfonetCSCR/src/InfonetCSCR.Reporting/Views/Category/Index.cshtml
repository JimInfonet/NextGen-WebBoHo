<div class="row" id="reportDiv">
    <div class="col-lg-12 col-md-12 col-sm-12">
        <div id="reportBlock"></div>
    </div>
</div>

<div id="loading">
    <img id="loading-image" src="~/Images/loader.gif" alt="Loading..." />
</div>

@section Scripts
{
    <script src="~/Scripts/Category.js" type="text/javascript"></script>
    <script src="~/Scripts/Script.js" type="text/javascript"></script>
    <script>
        var getReportFilter = '@Url.Action("GetReportFilter", "Category", new { access_token = ViewBag.jwtToken })';
        var getDailySalesReport = '@Url.Action("GetDailySalesReport", "Category")';
        var getStockMoveMentReport = '@Url.Action("GetStockMoveMentReport", "Category")';
        var getNoStockMoveMentReport = '@Url.Action("GetNoStockMoveMentReport", "Category")';
        var getDepartmentSalesReport = '@Url.Action("GetDepartmentSalesReport", "Category")';
        var getQuantityLeaderReport = '@Url.Action("GetQuantityLeaderReport", "Category")';
        var getHistoricalInventoryLevelReport = '@Url.Action("GetHistoricalInventoryLevelReport", "Category")';
        var getHourlySalesReport = '@Url.Action("GetHourlySalesReport", "Report")';
        var getDeptSalesLastSixWeeksReport = '@Url.Action("GetDeptSalesLastSixWeeksReport", "Category")';
        var getShelfLabelReport = '@Url.Action("GetShelfLabelReport", "Category")';
        var getReportUrl = '@Url.Action("LoadReports", "Category")';
    </script>
}

