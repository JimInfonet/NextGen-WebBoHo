        <div>
            <label>Dept</label>
        </div>
        @*<div>
                <select id="deptSelect" class="form-control"></select>
            </div>*@
        <div>
            <input id="deptSelect" class="form-control" />
        </div>
    </div>
    <div class="rangeDeptFilter col-lg-3 col-xs-12">
