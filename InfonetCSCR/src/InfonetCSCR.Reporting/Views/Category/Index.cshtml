@{ ViewBag.Title = "Category Report"; }
<div id="error" class="alert alert-danger alert-dismissible" role="alert">
    <span id="errorMessage"></span>
</div>

<div class="mt-2">
    <h3 class="fw-bold mb-3">@ViewBag.Title</h3>

    <div class="card" style="height: 100px;">
        <div class="card-body px-3 py-2">
            <div class="row">
                <div id="CategorySelect" class="col-lg-3 col-md-4 col-sm-12 d-flex flex-column justify-content-end">
                    <label>Category</label>
                    <select id="drpCategorySelect" class="form-control">
                        <option value="All">All</option>
                        <option value="1">AR customers</option>
                        <option value="2">Departments</option>
                        <option value="3">Gift card & loyalty</option>
                        <option value="4">Graphical report</option>
                        <option value="5">Inventory</option>
                        <option value="6">Kits</option>
                        <option value="7">Others</option>
                        <option value="8">Policies</option>
                        <option value="9">Pricing</option>
                        <option value="10">Product Classifications</option>
                        <option value="11">Sales information</option>
                        <option value="12">Security</option>
                        <option value="13">Tax</option>
                        <option value="14">Tenders</option>
                    </select>
                </div>

                <div id="ReportSelect" class="col-lg-3 col-md-4 col-sm-12 d-flex flex-column justify-content-end">
                    <label>Select Report</label>
                    <select id="drpReportSelect" class="form-control"></select>
                </div>

                <div class="col-lg-3 col-md-4 col-sm-12 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2" id="submitBtn">Load</button>
                    <button type="button" class="btn btn-primary" id="printBtn">Export to PDF</button>
                </div>
            </div>
        </div>
    </div>
</div>
<br />
<div class="row">
    @if (ViewBag.IsHeadOffice)
    {
        <div class="col-lg-3 col-xs-12">
            <div>
                <label>Select Store</label>
            </div>
            <div>
                @Html.DropDownList("drpStoreSelect", (IEnumerable<SelectListItem>)ViewBag.Stores, new { @class = "form-control" })
            </div>
        </div>}
    <div class="singleMovDateFilter col-lg-3 col-xs-12">
        <div>
            <label>Stock Movement Date <= </label>
        </div>
        <div>
            <input type="date" id="singleMovDate" max="9999-12-31" pattern="[0-9]{4}" class="form-control" />
        </div>
    </div>
    <div class="singleDateFilter col-lg-3 col-xs-12">
        <div>
            <label>Date</label>
        </div>
        <div>
            <input type="date" id="singleDate" max="9999-12-31" pattern="[0-9]{4}" class="form-control" />
        </div>
    </div>
    <div class="rangeDateFilter col-lg-3 col-xs-12">
        <div>
            <label>Date</label>
        </div>
        <div>
            between <input type="date" id="startDate" max="9999-12-31" pattern="[0-9]{4}" class="form-control" />
        </div>
        <div>
            and <input type="date" id="endDate" max="9999-12-31" pattern="[0-9]{4}" class="form-control" />
        </div>
    </div>
