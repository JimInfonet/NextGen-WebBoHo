<div class="modal fade" id="salesDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h4 class="modal-title" id="modal-title"></h4>
            </div>
            <div class="modal-body">
                <h4 id="date-details" class="sales-details-table"></h4>
                <div class="table-responsive">
                    <table class="table table-condensed table-striped">
                        <thead id="salesDetailsHeader" class="fixed-header">
                        </thead>
                        <tbody id="salesDetailsBody" class="sales-details-table"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div class="row" id="dailySalesReportContainer">
    <h4 style="padding-left:15px" class="text-center">
        @Session["CompanyName"].ToString()
    </h4>    
    <h2 style="padding-left:15px" class="text-center">Daily Sales Report</h2>
    <h4 id="salesDate" style="padding-left:15px" class="text-center"></h4>
    <div class="col-lg-7">
        <h3>Fuel Sales</h3>
        <div>
            <table id="fuelTable" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>QTY</th>
                        <th class="align-right">Sales</th>
                    </tr>
                </thead>
                <tbody id="fuelTableBody"></tbody>
            </table>
        </div>

        <h3>C-Store Sales</h3>
        <div>
            <table id="cStoreTable" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Dept</th>
                        <th>QTY</th>
                        <th class="align-right">Sales</th>
                    </tr>
                </thead>
                <tbody id="cStoreTableBody"></tbody>
            </table>
        </div>

        <div>
            <table id="salesTotalTable" class="table">
                <thead>
                    <tr>
                        <th>Total</th>
                        <th>QTY</th>
                        <th class="align-right">Sales</th>
                    </tr>
                </thead>
                <tbody id="salesTotalTableBody"></tbody>
            </table>
        </div>

        <h3>Sales Taxes</h3>
        <div>
            <table id="salesTaxTable" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Tax Name</th>
                        <th class="align-right">Included</th>
                        <th class="align-right">Added</th>
                        <th class="align-right">Total</th>
                    </tr>
                </thead>
                <tbody id="salesTaxTableBody"></tbody>
            </table>
        </div>
        <h3>Sales Charges</h3>
        <div>
            <table id="salesChargeTable" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="align-right">Amount</th>
                    </tr>
                </thead>
                <tbody id="salesChargesTableBody"></tbody>
            </table>
        </div>
        <h3>Receipts</h3>
        <div>
            <table id="salesReceiptsTable" class="table table-hover table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="align-right">Amount</th>
                    </tr>
                </thead>
                <tbody id="salesReceiptsTableBody"></tbody>
            </table>
        </div>
        <div>
            <table id="totalDailySalesTable" class="table">
                <thead>
                    <tr>
                        <th>Total</th>
                        <th class="align-right">Amount</th>
                    </tr>
                </thead>
                <tbody id="totalDailySales" class="font-bold"></tbody>
            </table>
        </div>
    </div>
    <div class="col-lg-5">
        <div id="fuelChart">
            <h3>Fuel Sales Chart</h3>
            <canvas id="fuelSalesChart" class="sales-chart-height"></canvas>
        </div>

        <div id="cStoreChart">
            <h3>C-Store Sales Chart</h3>
            <canvas id="cStoreSalesChart" class="sales-chart-height"></canvas>
        </div>

        <div id="receiptChart">
            <h3>Receipt Chart</h3>
            <canvas id="salesReceiptChart" class="sales-chart-height"></canvas>
        </div>
    </div>
</div>

<script src="~/Scripts/DailySalesReport.js" type="text/javascript"></script>

<script>
    var getSalesReportData = '@Url.Action("GetSalesReportData", "Report")';
    var getSalesDetails = '@Url.Action("GetSalesDetails", "Report")';
    var getSalesTaxesDetails = '@Url.Action("GetSalesTaxesDetails", "Report")';
    var getSalesChargesDetails = '@Url.Action("GetSalesChargesDetails", "Report")';
    var getSalesReceiptsDetails = '@Url.Action("GetSalesReceiptDetails", "Report")';

    $(document).ready(function () {
        loadSalesReport();
    });
</script>

