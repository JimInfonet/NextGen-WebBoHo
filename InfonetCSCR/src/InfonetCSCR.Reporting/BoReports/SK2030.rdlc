                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(trim(Fields!Stock_Code.Value)&lt;&gt;"&lt;NONE&gt;",Fields!DESCRIPT.Value,
iif(trim(Fields!SubDetail.Value)&lt;&gt;"&lt;NONE&gt;",Fields!DEPT_NAME.Value + " \ " + Fields!SUB_NAME.Value + " \ " + Fields!SubDetail_Name.Value,
iif(trim(Fields!SUB_DEPT.Value)&lt;&gt;"&lt;NONE&gt;",Fields!DEPT_NAME.Value + " \ " + Fields!SUB_NAME.Value, 
iif(trim(Fields!Dept.Value)&lt;&gt;"&lt;NONE&gt;", Fields!DEPT_NAME.Value,""))))</Value>
                                  <Style />
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>DESCRIPT</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
