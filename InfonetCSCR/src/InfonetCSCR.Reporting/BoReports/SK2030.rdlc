                        <Textbox Name="Stock_Code">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=iif(trim(Fields!Stock_Code.Value)&lt;&gt;"&lt;NONE&gt;",Fields!Stock_Code.Value,
iif(trim(Fields!SubDetail.Value)&lt;&gt;"&lt;NONE&gt;",Fields!Dept.Value + " \ " + Fields!SUB_DEPT.Value + " \ " + Fields!SubDetail.Value,
iif(trim(Fields!SUB_DEPT.Value)&lt;&gt;"&lt;NONE&gt;",Fields!Dept.Value + " \ " + Fields!SUB_DEPT.Value, 
iif(trim(Fields!Dept.Value)&lt;&gt;"&lt;NONE&gt;", Fields!Dept.Value,""))))</Value>
                                  <Style />
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Stock_Code</rd:DefaultName>
