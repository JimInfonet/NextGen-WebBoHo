@section Head {
    @* <link href="~/css/repCloseBatch.css" rel="stylesheet" asp-append-version="true" /> *@
    <link rel="stylesheet" type="text/css" href="~/css/site.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
}
@inject IApplicationConfig _config
@inject IViewLocalizer localizer
@inject IHttpContextAccessor httpContextAccessor
@{
    ViewData["Title"] = @localizer["pageTitle"];
}
<input id="errorMessage" type="hidden" value="@localizer["errorMessage"]" />
<div id="isBackOffice" hidden>@_config.IsBackOffice</div>
<input id="search" type="hidden" value="@localizer["search"]" />
<input id="CloseBDays" type="hidden" value="@ViewData["CloseBDays"]" />

<title>CSHTML with Group Frame</title>
<!-- Add necessary CSS links and scripts here -->
<style>
    /* Style for the group frame */
    .group-frame {
        border: 1px solid #ccc;
        padding: 10px;
        margin-bottom: 15px;
    }

    /* Style for the group frame title */
    .group-title {
        font-weight: bold;
        margin-bottom: 5px;
    }
    /* Style for the table container */
    .table {
        display: table;
        width: 70%;
        border-collapse: collapse;
        margin-bottom: 5px;
        /* Add other styling properties as needed */
    }

    /* Style for table header */
    .table-header {
        display: table-header-group;
        font-weight: bold;
        /* Add other header styling properties */
    }

    /* Style for table body */
    .table-body {
        display: table-row-group;
    }

    /* Style for table rows */
    .table-row {
        display: table-row;
        border: 0px thin #ccc;
        /* Add row styling properties */
    }


    /* Style for table cells */
    .table-cell {
        display: table-cell;
        border: 0px thin #ccc;
        padding: 5px;
        /* Add cell styling properties */
    }

    .u_table {
        max-width: 900px; /* Set your desired maximum width */
        margin: 0 auto; /* Center the container */
        padding: 20px;
        height: 600px; /* Set a fixed height for the container */
        overflow-y: auto; /* Add vertical scrollbar */
    }

    .u_row {
        display: flex;
    }

     .u_row:focus {
        background-color: skyblue; /* Highlight when focused */
    }

    .u_row:not(:focus) {
        background-color: transparent; /* Reset when not focused */
    }

    .u_header {
        font-weight: bold;
        display: table-row-group;
        background-color: #f2f2f2;
    }

    .u_body {
        display: table-row-group;
    }

    .u_cell {
        width: 115px;
        flex: 1;
        padding: 10px;
        border: 1px solid #ddd;
    }

</style>

<input id="error-message-for-list-load" type="hidden" value="@localizer["errorMessageForListLoad"]" />

<div class="px-3 py-2 mt-2">
    <div class="d-flex justify-content-between">
        <h3 class="h3 fw-bold mb-3">@localizer["Reprint Till Close"]</h3>
    </div>

    <div class="page-content p-4 h-100 row">
        <div class="d-flex flex-column col">
            @if (!_config.IsBackOffice)
            {
                <div class="group-frame">
                    <div class="group-title">Select a store</div>
                    <div class="dropdown col-6 mt-1 mb-1" style="height: 25px;">
                        <select class="form-select col-3" aria-label="Default select example" id="selectStore">
                            <option value="All" selected>All</option>
                        </select>
                    </div>
                </div>
            }

            <div class="group-frame" id="groupTill">
                <div class="group-title">Select Close Report Criteria</div>
                <input type="radio" id="rbTill" name="radioButtons" value="option1" checked="checked" onclick="toggleGroupFrame('option1')">
                <label for="radioButton1">By Till Close Number</label><br>

                <input type="radio" id="rbShift" name="radioButtons" value="option2" onclick="toggleGroupFrame('option2')">
                <label for="radioButton2">By Shift & Date</label><br>

                <input type="radio" id="rbDate" name="radioButtons" value="option3" onclick="toggleGroupFrame('option3')">
                <label for="radioButton3">By Date Range</label><br>
            </div>

            <div class="group-frame" id="groupShift" style="display: none;">
                <div class="group-title">Select Date & Shift</div>
                <!-- Date and time picker for Start Date -->
                <div class="table">
                    <div class="table-body">
                        <div class="table-row">
                            <div class="table-cell">ShiftDate:</div>
                            <div class="table-cell"><input type="date" class="text-danger" id="shift-date" name="shiftDate"/></div>
                        </div>
                    </div>
                    <div class="table-body">
                        <div class="table-row">
                            <div class="table-cell">ShiftNumber:</div>
                            <div class="table-cell">
                                @* <input type="text" class="text-danger" id="shiftCombo" name="shiftNumbers" /> *@
                                <select id="shiftCombo">
                                    <option value="All">All</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="table-body">
                        <div class="table-row">
                            <div class="table-cell"></div>
                            <button type="button" class="btn btn-default text-center btn-outline-success" onclick="refreshTable('option2')">GenerateReport</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="group-frame" id="groupDate" style="display: none;">
                <div class="group-title">Select Start & End Dates</div>
                <!-- Date and time picker for Start Date -->
                <div class="table">
                    <div class="table-header">
                        <div class="table-row">
                            <div class="table-cell"></div>
                            <div class="table-cell">Date</div>
                            <div class="table-cell">Time</div>
                        </div>
                    </div>
                    <div class="table-body">
                        <div class="table-row">
                            <div class="table-cell">Start:</div>
                            <div class="table-cell"><input type="date" class="text-danger" id="start-date" name="startDate" /></div>
                            <div class="table-cell"><input type="time" class="text-danger" id="start-time" name="starttime" /></div>
                        </div>
                    </div>
                    <div class="table-body">
                        <div class="table-row">
                            <div class="table-cell">End:</div>
                            <div class="table-cell"><input type="date" class="text-danger" id="end-date" name="endDate" /></div>
                            <div class="table-cell"><input type="time" class="text-danger" id="end-time" name="endtime" /></div>
                        </div>
                    </div>
                    <div class="table-body">
                        <div class="table-row">
                            <div class="table-cell"></div>
                            <button type="button" class="btn btn-default text-center btn-outline-success" onclick="refreshTable('option3')">GenerateReport</button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="group-frame" id="groupList" style="display: block;">
                <div class="d-flex flex-column col">
                    <div class="container overflow-scroll custom-grid-scrollbar border-2" style="max-width:3000px;">
                        <table id="tillCloses-grid" class="table table-striped" width="20%">
                            <thead>
                                <tr>
                                    <th width="10%" id="CloseNo">@localizer["Close#"]</th>
                                    <th width="15%" id="OpenDate">@localizer["OpenDate"]</th>
                                    <th width="10%" id="OpenTime">@localizer["OpenTime"]</th>
                                    <th width="15%" id="CloseDate">@localizer["CloseDate"]</th>
                                    <th width="10%" id="CloseTime">@localizer["CloseTime"]</th>
                                    <th width="10%" id="TillNo">@localizer["Till#"]</th>
                                    <th width="15%" id="ShiftDate">@localizer["ShiftDate"]</th>
                                    <th width="10%" id="ShiftNo">@localizer["Shift#"]</th>
                                </tr>
                            </thead>
                            <tfoot>
                                <tr>
                                    <th class="input" width="10%" scope="col"></th>
                                    <th class="input" width="15%" scope="col"></th>
                                    <th class="input" width="10%" scope="col"></th>
                                    <th class="input" width="15%" scope="col"></th>
                                    <th class="input" width="10%" scope="col"></th>
                                    <th class="input" width="10%" scope="col"></th>
                                    <th class="input" width="15%" scope="col"></th>
                                    <th class="input" width="10%" scope="col"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex flex-column col">
            <div class="mt-4">
                <div class="d-flex gap-3 mb-4">
                    <button id="btn-export" type="button" class="btn btn-default text-center btn-outline-success" onclick="exportButtonClicked()" disabled>@localizer["Export"]</button>
                    <button id="btn-print" type="button" class="btn btn-default text-center btn-outline-success" onclick="printButtonClicked()" disabled>@localizer["Print"]</button>
                </div>

                <!-- RichTextBox -->
                <textarea id="TillCloseTextArea" name="TillCloseTextArea" rows="28" cols="50">
                </textarea>
                <br><br>

            </div>
        </div>
    </div>
</div>
<script>
    function toggleGroupFrame(groupToShow) {
        var groupFrame1 = document.getElementById("groupTill");
        var groupFrame2 = document.getElementById("groupShift");
        var groupFrame3 = document.getElementById("groupDate");
        var groupFrame4 = document.getElementById("groupList");

        if (groupToShow === "option1") {
            groupFrame1.style.display = "block";
            groupFrame2.style.display = "none";
            groupFrame3.style.display = "none";
            groupFrame4.style.display = "block";
        } else if (groupToShow === "option2") {
            groupFrame1.style.display = "block";
            groupFrame2.style.display = "block";
            groupFrame3.style.display = "none";
            groupFrame4.style.display = "none";
        } else if (groupToShow === "option3") {
            groupFrame1.style.display = "block";
            groupFrame2.style.display = "none";
            groupFrame3.style.display = "block";
            groupFrame4.style.display = "none";
        }
    }
</script>
@section Scripts {
    <script src="~/js/repTillClose.js" asp-append-version="true"></script>
}