@section Head {
  <link href="~/css/restrictions.css" rel="stylesheet" asp-append-version="true" />
}

@model RestrictionsViewModel
@inject IApplicationConfig _config
@inject IViewLocalizer localizer
@inject IHttpContextAccessor httpContextAccessor
@{
  ViewData["Title"] = @localizer["restrictions"];
}

<input id="codeAlreadyExists" type="hidden" value="@localizer["codeAlreadyExists", "{0}"]" />
<input id="restrictionAddedSuccessfully" type="hidden" value="@localizer["restrictionAddedSuccessfully"]" />
<input id="restrictionUpdatedSuccessfully" type="hidden" value="@localizer["restrictionUpdatedSuccessfully"]" />
<input id="restrictionUpdatedSuccessfully" type="hidden" value="@localizer["restrictionUpdatedSuccessfully"]" />
<input id="deleteRestrictionTitle" type="hidden" value="@localizer["deleteRestrictionTitle"]" />
<input id="deleteRestrictionMessage" type="hidden" value="@localizer["deleteRestrictionMessage"]" />
<input id="restrictionDeletedSuccessfully" type="hidden" value="@localizer["restrictionDeletedSuccessfully"]" />
<input id="codeRange" type="hidden" value="@localizer["codeRange"]" />
<input id="ageLimitRange" type="hidden" value="@localizer["ageLimitRange"]" />

<form class="p-3 mt-2" asp-controller="Restrictions" asp-action="UpdateRestriction" id="RestrictionsForm">
  <div class="p-2">
    <div class="d-flex justify-content-between">
      <h3 class="h3 fw-bold mb-3">@localizer["restrictionsDefinition"]</h3>
    </div>

    <div class="container body-content p-2" style="max-width:3000px;">
      @*Restrictions Datatable Section*@
      <div class="container custom-grid-scrollbar border-2" style="max-width:3000px;">
        <table id="restrictions-grid" class="table table-striped" style="width:100%">
          <thead>
            <tr>
              <th width="30%" id="Code">@localizer["code"]</th>
              <th width="40%" id="RestrictionsDescription">@localizer["restrictionDescription"]</th>
              <th width="30%" id="AgeLimit">@localizer["ageLimit"]</th>
            </tr>
          </thead>
        </table>
      </div>

      <div class="p-2 row">
        <div class="d-flex gap-3 col-xl-8 col-lg-9">
          <button id="btn-add" type="button" class="btn btn-footer btn-primary text-center align-items-center" onclick="onRestrictionAddClick()">@localizer["add"]</button>
          <button id="btn-edit" type="button" class="btn btn-footer btn-primary align-items-center" onclick="onRestrictionEditClick()">@localizer["edit"]</button>
          <button id="btn-delete" type="button" class="btn btn-footer btn-danger text-center align-items-center" onclick="onRestrictionDeleteClick()">@localizer["delete"]</button>
        </div>
      </div>
    </div>
  </div>
</form>

<div class="modal fade" id="restrictionFormModal" tabindex="1" role="dialog" area-modal="true">
  <div class="modal-dialog modal-dialog-centered restriction-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h5 id="restriction-form-section-title" class="modal-title">@localizer["restrictionForm"]</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="restriction-form">
          <div class="row p-3">
            <div class="col-5">
              <label class="mb-2">@localizer["code"]</label>
              <input id="code" type="text" maxlength="2" class="infonet-input w-100 not-editable clear-selected-input-on-keypress only-digit" />
              <span id="validation-for-code" class="text-danger">@localizer["thisFieldIsRequired"]</span>
              <span id="validation-for-code-range" class="text-danger">@localizer["codeRange"]</span>
            </div>
            <div class="col-7">
              <label class="mb-2">@localizer["ageLimit"]<em class="age-limit-suggestion"> (@localizer["leaveEmptyOrZeroForNoAgeLimit"])</em></label>
              <input id="age-limit" type="number" class="infonet-input w-100 clear-selected-input-on-keypress only-digit-decimal" />
              <span id="validation-for-age-limit" class="text-danger">@localizer["ageLimitRange"]</span>
            </div>
          </div>
          <div class="row gap-3 p-3">
            <div class="col">
              <label class="mb-2">@localizer["restriction"]</label>
              <input id="restriction" type="text" maxlength="75" class="infonet-input w-100" />
              <span id="validation-for-restriction" class="text-danger">@localizer["thisFieldIsRequired"]</span>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-cancel btn-outline-danger align-content-center btn-sm me-2" data-bs-dismiss="modal">@localizer["cancel"]</button>
        <button type="button" class="btn btn-primary btn-sm btn-save" onclick="onRestrictionCompleteClick()">@localizer["complete"]</button>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/restrictions.js" asp-append-version="true"></script>
}