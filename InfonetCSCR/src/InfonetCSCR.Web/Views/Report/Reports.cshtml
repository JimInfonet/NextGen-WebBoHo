@section Scripts
    {
    <script src="~/js/CategoryReport.js" type="text/javascript"></script>
    <script src="~/js/Report.js" asp-append-version="true"></script>
    <script>
        var getReportFilter = '@Url.Action("GetReportFilter", "Dashboard")';
        var getDailySalesReport = '@Url.Action("GetDailySalesReport", "Dashboard")';
        var getStockMoveMentReport = '@Url.Action("GetStockMoveMentReport", "Dashboard")';
        var getNoStockMoveMentReport = '@Url.Action("GetNoStockMoveMentReport", "Dashboard")';
        var getDepartmentSalesReport = '@Url.Action("GetDepartmentSalesReport", "Dashboard")';
        var getQuantityLeaderReport = '@Url.Action("GetQuantityLeaderReport", "Dashboard")';
        var getHistoricalInventoryLevelReport = '@Url.Action("GetHistoricalInventoryLevelReport", "Dashboard")';
        var getHourlySalesReport = '@Url.Action("GetHourlySalesReport", "Dashboard")';
        var getDeptSalesLastSixWeeksReport = '@Url.Action("GetDeptSalesLastSixWeeksReport", "Dashboard")';
        var getShelfLabelReport = '@Url.Action("GetShelfLabelReport", "Dashboard")';
        var getReportUrl = '@Url.Action("LoadReports", "Dashboard")';
    </script>
