@section Head {
  <link href="~/css/customer.css" rel="stylesheet" asp-append-version="true" />
}

@model CustomerViewModel
@inject IViewLocalizer localizer
@inject IApplicationConfig _config
@{
  ViewData["Title"] = @localizer["pageTitle"];
  bool custMem = ViewData["CUST_MEM"]?.ToString() == "Customer";
  bool isBackOffice = ViewData["IsBackOffice"]?.ToString()!.ToLower() == "true";
  bool securityAR = ViewData["securityAR"]?.ToString()!.ToLower() == "true";
  bool taxExempt = (bool)ViewData["TAX_EXEMPT"]!;
  bool tePayPump = (bool)ViewData["TE_PAYPUMP"]!;
  string teType = ViewData["TE_Type"]?.ToString()!;
  bool enableBandAccT = (bool)ViewData["EnableBandAccT"]!;
}

<input id="CUST_MEM" type="hidden" value="@custMem" />
<input id="back" type="hidden" value="@localizer["back"]" />
<input id="isConflict" type="hidden" value="@localizer["isConflict"]" />
<input id="errorMessage" type="hidden" value="@localizer["errorMessage"]" />
<input id="confirmGoBackAlert" type="hidden" value="@localizer["confirmGoBackAlert"]" />
<input id="loyaltyNumAlreadyExists" hidden value="@localizer["loyaltyNumAlreadyExists"]" />
<input id="failedToLoadRewardCards" type="hidden" value="@localizer["failedToLoadRewardCards"]" />
<input id="customerCard" type="hidden" value="@localizer[custMem ? "customerCard" : "memberCard"]" />
<input id="confirmGoToAnotherPageAlert" type="hidden" value="@localizer["confirmGoToAnotherPageAlert"]" />
<input id="customerCodeAlreadyExists" hidden value="@localizer[custMem ? "customerCodeAlreadyExists": "memberCodeAlreadyExists"]" />
<input id="customerCreatedSuccessfully" type="hidden" value="@localizer[custMem ? "customerCreatedSuccessfully" : "memberCreatedSuccessfully"]" />
<input id="customerUpdatedSuccessfully" type="hidden" value="@localizer[custMem ? "customerUpdatedSuccessfully" : "memberUpdatedSuccessfully"]" />

<input type="hidden" id="modelData" name="modelData" value='@Json.Serialize(Model)' />

@if (Model != null)
{
  <input id="restriction-profile-select-from-model" hidden value="@Model.ProfileID" />
  <input id="group-number-select-from-model" hidden value="@Model.GroupID" />
  <input id="status-select-from-model" hidden value="@Model.Status" />
}

<input id="isCustomerCodeAlreadyExists" hidden value='@(ViewData["IsCustomerCodeAlreadyExists"] != null ? "true" : "false")' />
<input id="isLoyaltyNumberAlreadyExists" hidden value='@(ViewData["IsLoyaltyNumberAlreadyExists"] != null ? "true" : "false")' />
<input id="isLoyaltyNumberAlreadyExistsAdd" hidden value='@(ViewData["IsLoyaltyNumberAlreadyExistsAdd"] != null ? "true" : "false")' />
<input id="isLoyaltyNumberAlreadyExistsUpdate" hidden value='@(ViewData["IsLoyaltyNumberAlreadyExistsUpdate"] != null ? "true" : "false")' />

<input id="groupID" type="hidden" value="@localizer["groupID"]" />

<form class="p-3 mt-2" asp-controller="Customer" asp-action="SaveCustomer" id="customerForm">
  <div class="d-flex justify-content-between">
    <h3 class="h3 fw-bold mb-3">
      @(custMem ? localizer["customers"] : localizer["members"])
    </h3>
  </div>
  <div class="customer-form p-3">

    <div class="mt-3">
      <div class="border-bottom mx-3">
        <p class="form-section-title">
          @(custMem ? localizer["basicCustomerData"] : localizer["basicMemberData"])
        </p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="Code" class="mb-2">@localizer["code"]</label>
            <input asp-for="Code" id="customer-code" type="text" class="infonet-input w-100 not-editable" required />
            <span asp-validation-for="Code" class="text-danger code-field-required"></span>
          </div>
          <div class="col">
            <label asp-for="Name" class="mb-2">@localizer["name"]</label>
            <input asp-for="Name" id="name" type="text" class="infonet-input w-100 edit-mode-control" required />
            <span asp-validation-for="Name" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Category" class="mb-2">@localizer["category"]</label>
            <input asp-for="Category" id="category" type="text" class="infonet-input w-100 edit-mode-control" />
            <span asp-validation-for="Category" class="text-danger"></span>
          </div>
        </div>

        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="CustomerDiscount" class="mb-2">@localizer["discountCode"]</label>
            <input asp-for="CustomerDiscount" id="customer-discount" type="text" class="infonet-input w-100 edit-mode-control" />
            <span asp-validation-for="CustomerDiscount" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="PriceCode" class="mb-2">@localizer["priceNumber"]</label>
            <input asp-for="PriceCode" id="price-code" type="number" class="infonet-input w-100 edit-mode-control clear-selected-input-on-keypress only-digit" min="0" max="9" data-val=true data-val-number="@localizer["pleaseEnterAValidNumber"]" />
            <span asp-validation-for="PriceCode" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Status" class="mb-2">@localizer["status"]</label>
            <select asp-for="Status" id="status-select" class="form-select col infonet-input edit-mode-control" aria-label="Select Status" onchange="toggleInputs(this.options[this.selectedIndex].value);">
              <option value="A">@localizer["active"]</option>
              <option value="I">@localizer["inactive"]</option>
              <option value="F">@localizer["frozen"]</option>
              <option value="H">@localizer["hidden"]</option>
            </select>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="address">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["address"]</p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="Address1" class="mb-2">@localizer["address1"]</label>
            <input asp-for="Address1" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Address1" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Address2" class="mb-2">@localizer["address2"]</label>
            <input asp-for="Address2" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Address2" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="City" class="mb-2 w-100 edit-mode-control">@localizer["city"]</label>
            <input asp-for="City" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="City" class="text-danger"></span>
          </div>
        </div>
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="Province" class="mb-2">@localizer["province"]</label>
            <input asp-for="Province" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Province" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Country" class="mb-2">@localizer["country"]</label>
            <input asp-for="Country" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Country" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="PostalCode" class="mb-2 w-100 edit-mode-control">@localizer["postalCode"]</label>
            <input asp-for="PostalCode" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="PostalCode" class="text-danger"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="phonesFax">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["phones&Fax"]</p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="AreaCode" class="mb-2">@localizer["areaCode"]</label>
            <input asp-for="AreaCode" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="AreaCode" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Phone" class="mb-2">@localizer["phone"]</label>
            <input asp-for="Phone" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Phone" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Toll" class="mb-2 w-100 edit-mode-control">@localizer["tollFree"]</label>
            <input asp-for="Toll" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Toll" class="text-danger"></span>
          </div>
        </div>
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="OfficePhone" class="mb-2">@localizer["officePhone"]</label>
            <input asp-for="OfficePhone" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="OfficePhone" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Fax" class="mb-2">@localizer["fax"]</label>
            <input asp-for="Fax" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Fax" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Contact1" class="mb-2 w-100 edit-mode-control">@localizer["contactPers"]</label>
            <input asp-for="Contact1" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Contact1" class="text-danger"></span>
          </div>
        </div>
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="CellPhone" class="mb-2">@localizer["cellPhone"]</label>
            <input asp-for="CellPhone" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="CellPhone" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="Email" class="mb-2">@localizer["email"]</label>
            <input asp-for="Email" class="col infonet-input w-100 edit-mode-control" type="text" />
            <span asp-validation-for="Email" class="text-danger"></span>
          </div>
          <div class="col">
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="loyaltyProgram">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["loyaltyProgram"]</p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="LoyaltyNumber" class="mb-2">@localizer["loyaltyNumber"]</label>
            <input asp-for="LoyaltyNumber" id="loyalty-number" class="col infonet-input w-100 edit-mode-control clear-selected-input-on-keypress only-digit-decimal-plus-minus" type="number" min="-999999999" max="9999999999" data-val=true data-val-number="@localizer["pleaseEnterAValidNumber"]" />
            <span asp-validation-for="LoyaltyNumber" class="text-danger"></span>
          </div>
          <div class="col">
            <label asp-for="LoyaltyPoints" class="mb-2">@localizer["loyaltyPoints"]</label>
            <input asp-for="LoyaltyPoints" readonly class="col infonet-input w-100" type="text" value="@(Model?.LoyaltyPoints?.ToString("0.00") ?? "0.00")" disabled />
            <span asp-validation-for="LoyaltyPoints" class="text-danger"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="taxExempt">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["taxExempt"]</p>
      </div>

      <div class="container">
        <div class="container">
          <div class="row gap-3 pt-3">
            <div class="form-check mt-2">
              <input asp-for="TaxExemptCheckbox" class="form-check-input tax-exempt-field" type="checkbox" disabled>
              <label asp-for="TaxExemptCheckbox" class="mb-2">
                @(custMem ? localizer["taxExemptCustomer"] : localizer["taxExemptMember"])
              </label>
            </div>
          </div>
        </div>
        <div class="row gap-3 pt-3">
          <div class="col">
            @if (teType == "SITE" && enableBandAccT)
            {
              <label asp-for="TECardNumber" class="mb-2">@localizer["teCardNumber"]</label>
              <input asp-for="TECardNumber" class="col infonet-input w-100 tax-exempt-field" type="text" disabled />
              <span asp-validation-for="TECardNumber" class="text-danger"></span>
            }
            else
            {
              <label asp-for="PlateNumber" class="mb-2">@localizer["vehiclePlateNumber"]</label>
              <input asp-for="PlateNumber" class="col infonet-input w-100 tax-exempt-field" type="text" disabled />
              <span asp-validation-for="PlateNumber" class="text-danger"></span>
            }
          </div>
          <div class="col">
          </div>
        </div>
      </div>
    </div>

    @if (securityAR)
    {
      <div class="mt-4" id="arInformation">
        <div class="border-bottom mx-3">
          <p class="form-section-title">@localizer["arInformation"]</p>
        </div>

        <div class="container">
          <div class="row gap-3 pt-3">
            <div class="col">
              <label asp-for="CreditLimit" class="mb-2">@localizer["creditLimit"]</label>
              <input asp-for="CreditLimit" type="number" class="col infonet-input w-100 edit-mode-control" data-val="true" data-val-number="@localizer["creditLimitTypeError"]" />
              <span asp-validation-for="CreditLimit" class="text-danger"></span>
            </div>
            <div class="col">
              <label asp-for="ParentAccount" class="mb-2">@localizer["parentAccount"]</label>
              <input asp-for="ParentAccount" class="col infonet-input w-100 edit-mode-control" type="text" />
              <span asp-validation-for="ParentAccount" class="text-danger"></span>
            </div>
          </div>
          <div class="row gap-3 pt-3">
            <div class="col">
              <label asp-for="CurrentBalance" class="mb-2">@localizer["currentARBalance"]</label>
              <input asp-for="CurrentBalance" class="col infonet-input w-100" type="text" value="@(Model?.CurrentBalance?.ToString("0.00") ?? "0.00")" disabled />
              <span asp-validation-for="CurrentBalance" class="text-danger"></span>
            </div>
            <div class="col">
            </div>
          </div>
          <div class="container">
            <div class="row gap-3 pt-3">
              <div class="form-check mt-2">
                <input asp-for="ARCustomerCheckbox" id="ARCustomerCheckbox"
                     class="form-check-input edit-mode-control"
                     onclick="toggleRestrictionProfile()" type="checkbox">
                <label asp-for="ARCustomerCheckbox" class="mb-2">
                  @(custMem ? localizer["arCustomer"] : localizer["arMember"])
                </label>
              </div>
              <div class="form-check mt-2">
                <input asp-for="UsePurchaseOrderCheckbox" id="UsePurchaseOrderCheckbox" class="form-check-input edit-mode-control" type="checkbox">
                <label asp-for="UsePurchaseOrderCheckbox" class="mb-2">@localizer["usePurchaseOrder"]</label>
              </div>
              <div class="form-check mt-2">
                <input asp-for="MultiUsePurchaseOrderCheckbox" id="MultiUsePurchaseOrderCheckbox" class="form-check-input edit-mode-control" type="checkbox">
                <label asp-for="MultiUsePurchaseOrderCheckbox" class="mb-2">@localizer["samePOMultipleTimes"]</label>
              </div>
            </div>
          </div>

          @*HO Only Start*@
          @if (!isBackOffice)
          {
            <div class="mt-4 border-bottom mx-3">
              <p class="form-section-title">@localizer["hoOnly"]</p>
            </div>
            <div class="row gap-3 pt-3">
              <div class="col">
                <label asp-for="DateOpen" class="mb-2">@localizer["dateOpen"]</label>
                <input asp-for="DateOpen" id="dateOpen" class="col infonet-input w-100 edit-mode-control not-editable" type="Date" value="@(Model == null ? DateTime.Today.ToString("yyyy-MM-dd") : Model.DateOpen?.ToString("yyyy-MM-dd"))" />
                <span asp-validation-for="DateOpen" class="text-danger"></span>
              </div>
              <div class="col">
                <label asp-for="LastSaleDate" class="mb-2">@localizer["dateLastSale"]</label>
                <input asp-for="LastSaleDate" id="lastSaleDate" class="col infonet-input w-100 edit-mode-control not-editable" type="Date" />
                <span asp-validation-for="LastSaleDate" class="text-danger"></span>
              </div>
            </div>
            <div class="row gap-3 pt-3">
              <div class="col">
                <label asp-for="LastPaymentDate" class="mb-2">@localizer["dateLastPayment"]</label>
                <input asp-for="LastPaymentDate" id="lastPaymentDate" class="col infonet-input w-100 edit-mode-control not-editable" type="Date" />
                <span asp-validation-for="LastPaymentDate" class="text-danger"></span>
              </div>
              <div class="col">
                <label asp-for="HighStmtBalance" class="mb-2">@localizer["highBalance"]</label>
                <input asp-for="HighStmtBalance" class="col infonet-input w-100 edit-mode-control not-editable" type="number" data-val=true data-val-number="@localizer["pleaseEnterAValidNumber"]" />
                <span asp-validation-for="HighStmtBalance" class="text-danger"></span>
              </div>
            </div>
            <div class="row gap-3 pt-3">
              <div class="col">
                <label asp-for="LastStmtBalance" class="mb-2">@localizer["lastSTMTBalance"]</label>
                <input asp-for="LastStmtBalance" class="col infonet-input w-100 edit-mode-control not-editable" type="number" data-val=true data-val-number="@localizer["pleaseEnterAValidNumber"]" />
                <span asp-validation-for="LastStmtBalance" class="text-danger"></span>
              </div>
              <div class="col">
                <label asp-for="LastPaymentBalance" class="mb-2">@localizer["lastPayment"]</label>
                <input asp-for="LastPaymentBalance" class="col infonet-input w-100 edit-mode-control not-editable" type="number" data-val=true data-val-number="@localizer["pleaseEnterAValidNumber"]" />
                <span asp-validation-for="LastPaymentBalance" class="text-danger"></span>
              </div>
            </div>
            <div class="row gap-3 pt-3">
              <div class="col">
                <label asp-for="StmtEmail" class="mb-2">@localizer["stmtEmail"]</label>
                <input asp-for="StmtEmail" class="col infonet-input w-100 edit-mode-control" type="text" />
                <span asp-validation-for="StmtEmail" class="text-danger"></span>
              </div>
              <div class="col"></div>
            </div>
          }
          @*HO Only End*@
        </div>
      </div>
    }

    <div class="mt-4" id="customerGroup">
      <div class="border-bottom mx-3">
        <p class="form-section-title">
          @(custMem ? localizer["customerGroup"] : localizer["memberGroup"])
        </p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="GroupID" class="mb-2">@localizer["groupNumber"]</label> <br />
            <div class="p-rel">
              <input id="group-number" asp-for="GroupID" type="text" class="p-rel editable-option-input infonet-input edit-mode-control" />
              <select id="group-number-select" class="p-abs top-0 pr-30 editable-option-select form-select infonet-input col edit-mode-control" onchange="changedGroupNumberSelect(this.options[this.selectedIndex].value, this.options[this.selectedIndex].innerText)" aria-label="Select Opt Data Profile ID">
              </select>
            </div>
          </div>
          <div class="col">
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="fuelRebate">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["fuelRebate"]</p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <div class="form-check mt-2">
              <input asp-for="UseFuelRebateCheckbox" id="useFuelRebateCheckbox" class="form-check-input fuel-rebate" type="checkbox" onchange="useFuelRebateCheckboxChanged()">
              <label asp-for="UseFuelRebateCheckbox" class="mb-2">@localizer["useFuelRebate"]</label>
            </div>
            <div class="form-check mt-2">
              <input asp-for="UseFuelRebateDiscountCheckbox" id="useFuelRebateDiscountCheckbox" class="form-check-input fuel-rebate" type="checkbox">
              <label asp-for="UseFuelRebateDiscountCheckbox" class="mb-2">@localizer["useFuelRebateDiscount"]</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="note">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["note"]</p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="Note" class="mb-2">@localizer["note"]</label>
            <textarea asp-for="Note" class="col infonet-input w-100 edit-mode-control" type="text"></textarea>
            <span asp-validation-for="Note" class="text-danger"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-4" id="restrictionProfile">
      <div class="border-bottom mx-3">
        <p class="form-section-title">@localizer["restrictionProfile"]</p>
      </div>

      <div class="container">
        <div class="row gap-3 pt-3">
          <div class="col">
            <label asp-for="ProfileID" class="mb-2">@localizer["restrictionProfile"]</label>
            <select asp-for="ProfileID" id="restriction-profile-select" class="form-select col infonet-input rstr-profile">
              <option value="">@localizer["select"] @localizer["restrictionProfile"]</option>
            </select>
          </div>
          <div class="col">
          </div>
        </div>
      </div>
    </div>


    @*Button section*@
    <div class="border-bottom mx-3 mt-4"></div>
    <div class="d-flex justify-content-end mt-3 px-3 gap-3">
      <button id="btn-cancel" onclick="cancelButtonClicked()" type="button" class="btn btn-footer btn-cancel btn-outline-danger align-content-center">@localizer["cancel"]</button>
      <button id="btn-save" onclick="saveButtonClicked()" type="submit" class="btn btn-footer btn-save text-center">@localizer["save"]</button>
      <button id="btn-edit" onclick="toggleEditMode()" type="button" class="btn btn-footer btn-save">@localizer["edit"]</button>
      <button id="btn-back" onclick="goToCustomersGridPage()" type="button" class="btn btn-footer btn-back btn-outline-danger">@localizer["back"]</button>
    </div>
  </div>
</form>

@section Scripts
  {
  <script src="~/js/customer.js" asp-append-version="true"></script>
  }
