@section Head {
  <link href="~/css/cardDefinitionGrid.css" rel="stylesheet" asp-append-version="true" />
}

@inject IViewLocalizer localizer
@{
  ViewData["Title"] = @localizer["cardDefinitionsGrid"];
}
<input type="hidden" id="pleaseSelectCardDefinitionBeforeDelete" value="@localizer["pleaseSelectCardDefinitionBeforeDelete"]" />
<input type="hidden" id="pleaseSelectCardDefinitionBeforeEdit" value="@localizer["pleaseSelectCardDefinitionBeforeEdit"]" />
<input type="hidden" id="anErrorOccurredWhileDeletingCard" value="@localizer["anErrorOccurredWhileDeletingCard"]" />
<input type="hidden" id="cannotDeleteCard" value="@localizer["cannotDeleteCard"]" />
<input type="hidden" id="cardCodeIsLinkedToTender" value="@localizer["cardCodeIsLinkedToTender", "{0}", "{1}"]" />

<div class="m-3">
  <h3>@localizer["cardDefinitionsGrid"]</h3>
</div>

<div class="m-3">
  <div class=" body-content p-2">
    <div class="container overflow-scroll custom-grid-scrollbar border-2" style="max-width:3000px;">
      <table id="cardDefinition-grid" class="table table-striped" style="width:100%">
        <thead>
          <tr>
            <th id="DTCardCode">@localizer["cardCode"]</th>
            <th id="DTCardName">@localizer["cardName"]</th>
            <th id="DTCardType">@localizer["cardType"]</th>
          </tr>
        </thead>
      </table>
    </div>
  </div>

  <div class="d-flex justify-content-end my-3">
    <button class="btn btn-back btn-danger float-end mx-4" onclick="deleteCardDefinition()">@localizer["delete"]</button>
    <button class="btn btn-footer btn-primary me-2" onclick="goToEditCardDefinition()">@localizer["editCardDefinition"]</button>
  </div>
</div>

@section Scripts
  {
  <script src="~/js/cardDefinitionGrid.js" asp-append-version="true"></script>
  }
