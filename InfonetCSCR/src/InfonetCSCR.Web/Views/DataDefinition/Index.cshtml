@section Head {
  <link href="~/css/pricebookTransfer.css" rel="stylesheet" asp-append-version="true" />
}

@inject IViewLocalizer localizer

<input id="userCode" type="hidden" value="@ViewData["UserCode"]?.ToString()" />
<input id="fromDataDefinition" type="hidden" value="@ViewData["FromDataDefinition"]?.ToString()" />

<input type="hidden" id="loading" value="@localizer["loading"]" />

<input id="byStore" type="hidden" value="@localizer["store"]" />
<input id="byPriceGroup" type="hidden" value="@localizer["priceGroups"]" />
<input id="byRegion" type="hidden" value="@localizer["region"]" />
<input id="byVendor" type="hidden" value="@localizer["vendors"]" />
<input id="dataDefinitionSuccessfullySaved" type="hidden" value="@localizer["dataDefinitionSuccessfullySaved"]" />
<input id="youCannotSelectTwoGSTorPST" type="hidden" value="@localizer["youCannotSelectTwoGSTorPST"]" />
<input id="youShouldSelectAtLeastOneItemToTransfer" type="hidden" value="@localizer["youShouldSelectAtLeastOneItemToTransfer"]" />

<div class="px-3 py-2 mt-2">
  <div class="d-flex justify-content-between">
    <h3 class="h3 fw-bold mb-3">@localizer["dataTransfer"]</h3>
  </div>

  <div class="page-content p-4 h-100">
    <div class="d-flex align-items-center row col-12 mb-4">
      <label class="mt-1 col-auto form-label fw-bold" for="data-transfer-type">@localizer["dataDefinitionType"]</label>
      <div class="col-lg-6 col-xl-3">
        <select class="form-select" id="dataDefinitionType" onchange="dataDefinitionTypeChanged(this.options[this.selectedIndex].value)">
          <option value="TAXES" selected>@localizer["taxes"]</option>
          <option value="CHARGES">@localizer["associatedCharges"]</option>
        </select>
      </div>
    </div>
  </div>

  <div class="">
    <div class="row m-3 mb-xl-3 ps-2">
      <div class="form-check col-xl-3 col-lg-6 mt-1 mb-1">
        <input class="form-check-input mt-2" id="showByStore" type="radio"
               onchange="showByOptionChanged()"
               name="show-by" value="by-store" checked>
        <label class="form-check-label mt-1" for="showByStore">@localizer["byStore"]</label>
      </div>

      <div class="form-check col-xl-3 col-lg-6 mt-1 mb-1">
        <input class="form-check-input mt-2" id="showByVendor" type="radio"
               onchange="showByOptionChanged()"
               name="show-by" value="by-vendor">
        <label class="form-check-label mt-1" for="showByVendor">@localizer["byVendor"]</label>
      </div>

      <div class="form-check col-xl-3 col-lg-6 mt-1 mb-1">
        <input class="form-check-input mt-2" id="showByRegion" type="radio"
               onchange="showByOptionChanged()"
               name="show-by" value="by-region">
        <label class="form-check-label mt-1" for="showByRegion">@localizer["byRegion"]</label>
      </div>

      <div class="form-check col-xl-3 col-lg-6 mt-1 mb-1">
        <input class="form-check-input mt-2" id="showByPriceGroup" type="radio"
               onchange="showByOptionChanged()"
               name="show-by" value="by-price-group">
        <label class="form-check-label mt-1" for="showByPriceGroup">@localizer["byPriceGroup"]</label>
      </div>
    </div>

    <div class="row">
      <div class="form-group col-4 selectStores">
        <div class="d-flex flex-column flex-xxl-row justify-content-between mt-3 mb-1" style="min-height:28px">
          <label class="fs-5 fw-bold" id="available-options-label">@localizer["store"]</label>
          <div class="form-group selectAllCheckbox d-flex align-items-center">
            <input class="form-check-input mt-2" id="select-or-unselect-all-stores" type="checkbox"
                   onchange="handleSelectOrUnselectAll()" value="select-or-unselect-all">

            <label class="form-check-label mt-1 selectAllCheckboxLabel text-ellipsis"  title="@localizer["select/UnselectAll"]" for="select-or-unselect-all-stores">@localizer["select/UnselectAll"]</label>
          </div>
        </div>
        <div class="form-control" id="available-options-container" style="height:200px;overflow-y: scroll;">
        </div>
      </div>

      <div class="form-group col-4 h5 fw-bold">
        <label class="mt-3 mb-xl-1 mb-sm-4 fw-bold" style="min-height:28px">@localizer["stores"]</label>
        <div class="form-control" id="selected-stores-container" style="height:200px;overflow-y: scroll;">
        </div>
      </div>

      <div class="form-group col-4 h5 fw-bold">
        <label class="mt-3 mb-xl-1 mb-sm-4 fw-bold" style="min-height:22px"></label>
        <div class="form-control" id="data-defintion-code-container" style="height:200px;overflow-y: scroll;">
        </div>
      </div>

      <div class="mt-5">
        <label class="mb-2 h5 fw-bold">@localizer["productSelection"]</label>
        <hr class="hr--sm" />

        <div class="mt-3 table-container">
          <table class="table table-striped" id="table--products" width="100%">
            <thead class="thead-light">
              <tr>
                <th id="DTProductsCol1" scope="col" width="30%">@localizer["productId"]</th>
                <th id="DTProductsCol2" scope="col" width="65%">@localizer["productName"]</th>
                <th id="DTProductsCol7" scope="col" width="5%">@localizer["sel"]</th>
              </tr>
            </thead>
          </table>
        </div>

        <div class="form-group mt-1">
          <input class="form-check-input mt-2" id="view__select-or-unselect-all-products"
                 type="checkbox" onclick="handleSelectOrUnselectAllProducts()">
          <label class="form-check-label mt-1" for="view__select-or-unselect-all-products">@localizer["select/UnselectAll"]</label>
        </div>
        <div class="d-flex flex-row-reverse mt-2 gap-3">
          <button class="btn btn-save btn-primary btn-sm" onclick="handleSaveButtonClicked()">@localizer["save"]</button>
          <button class="btn btn-save btn-danger btn-sm" id="save-as-pending-transfer-btn" onclick="goToStockDefinition()">@localizer["back"]</button>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts
  {
  <script src="~/js/dataDefinition.js" asp-append-version="true"></script>
  }
