<div class="px-3 py-2 mt-2">
  <div class="d-flex justify-content-between px-3">
    <h3 class="h3 fw-bold mb-3">@localizer["pricebookManagement"]</h3>
  </div>

  <div class="page-content p-4 h-100">
    <div class="d-flex align-items-center row col-12 mb-4">
      <label class="mt-1 col-auto form-label fw-bold">@localizer["priceBookType"]</label>
      <div class="col-lg-6 col-xl-3">
        <select class="form-select" id="data-transfer-type" onchange="handleDataTransferTypeChange()">
          <option value="price-change" selected>@localizer["priceChange"]</option>
          <option value="cost-change">@localizer["costChange"]</option>
          <option value="label-printing">@localizer["labelPrinting"]</option>
        </select>
      </div>
    </div>

    @* Nav tabs *@
    <ul class="nav nav-tabs nav-fill" id="tab" role="tablist">
      <li class="nav-item" id="selection-link-wrapper">
        <a class="nav-link active" id="selection-tab-link" role="tab" data-bs-toggle="tab" href="#selection-tab-pane">@localizer["priceChangeSelectionTab"]</a>
      </li>
      <li class="nav-item" id="view-tab-link-wrapper">
        <a class="nav-link" id="view-tab-link" role="tab" data-bs-toggle="tab" href="#view-tab-pane">@localizer["priceChangeViewTab"]</a>
      </li>
      <li class="nav-item" id="list-tab-link-wrapper">
        <a class="nav-link" id="list-tab-link" role="tab" data-bs-toggle="tab" href="#list-tab-pane">@localizer["priceChangeListTab"]</a>
      </li>
    </ul>

    @* Tab panes *@
    <div class="tab-content">

      @* Selection tab pane *@
      <div class="tab-pane fade active show" id="selection-tab-pane" role="tabpanel">
        <div class="d-flex gap-3 justify-content-start p-4">
          <button id="btn-categories" type="button" class="btn btn-primary text-center align-items-center" onclick="showProductCategories()">@localizer["productCategories"]</button>
          <button id="btn-vendors" type="button" class="btn btn-primary text-center align-items-center" onclick="showVendors()">@localizer["vendors"]</button>
        </div>
        <div id="productCategoryContainer">
          <div class="row pt-3">
            <div class="col-lg-12 col-xl-6">
              <div class="container border-2 max-width-3000">
                <table id="department-grid" class="table table-striped">
                  <thead>
                    <tr>
                      <th width="25%">@localizer["dept"]</th>
                      <th width="30%">@localizer["deptName"]</th>
                      <th width="25%">@localizer["sel"]</th>
                    </tr>
                  </thead>
                </table>
              </div>
              <div class="d-flex mt-2 ps-4">
                <input type="checkbox" class="form-check-input edit-mode-control" id="includeProducts">
                <label class="form-check-label ms-2">
                  @localizer["includeProducts"]
                </label>
              </div>
            </div>

            <div class="col-lg-12 col-xl-6">
              <div class="container border-2 max-width-3000 padding-top-30px">
                <table id="sub-department-grid" class="table table-striped">
                  <thead>
                    <tr>
                      <th width="25%">@localizer["dept"]</th>
                      <th width="25%">@localizer["subDept"]</th>
                      <th width="40%">@localizer["subDeptName"]</th>
                      <th width="10%">@localizer["sel"]</th>
                    </tr>
                  </thead>
                </table>
              </div>
              <div class="container border-2 max-width-3000 padding-top-30px">
                <table id="sub-detail-grid" class="table table-striped">
                  <thead>
                    <tr>
                      <th width="20%">@localizer["dept"]</th>
                      <th width="20%">@localizer["subDept"]</th>
                      <th width="20%">@localizer["subDetail"]</th>
                      <th width="30%">@localizer["subDetailName"]</th>
                      <th width="10%">@localizer["sel"]</th>
                    </tr>
                  </thead>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div id="vendorOptionContainer">
          <div class="d-flex flex-column my-3 vendorOptionsList">
            <select multiple class="form-select col" id="vendorOptions"></select>
          </div>
          <div class="d-flex flex-column my-3">
            <h5>@localizer["sortBy"]</h5>
            <div class="d-flex">
              <div class="form-check me-3">
                <input class="form-check-input" type="radio" name="sortBy" id="code" value="1" onclick="renderVendorOptionsPBM(this.value)" checked>
                <label class="form-check-label" for="code">@localizer["code"]</label>
              </div>
              <div class="form-check me-3">
                <input class="form-check-input" type="radio" name="sortBy" id="name" value="2" onclick="renderVendorOptionsPBM(this.value)">
                <label class="form-check-label" for="name">@localizer["name"]</label>
              </div>
            </div>
          </div>
        </div>
      </div>

      @* View tab pane*@
      <partial name="_PriceBookViewTab"></partial>
      
      @* List tab pane*@
      <partial name="_PriceBookListTab"></partial>
      
    </div>
  </div>
</div>

@section Scripts {
  <script src="~/js/storeSelectionByGroup.js" asp-append-version="true"></script>
  <script src="~/js/PricebookTransfer/pricebookTransfer.js" asp-append-version="true"></script>
  <script src="~/js/PricebookTransfer/stocks.js" asp-append-version="true"></script>
  <script src="~/js/PricebookManagement/pricebookManagement.js" asp-append-version="true"></script>
  <script src="~/js/PricebookTransfer/priceChange.js" asp-append-version="true"></script>
  <script src="~/js/PricebookTransfer/costChange.js" asp-append-version="true"></script>
  <script src="~/js/PricebookTransfer/labelPrint.js" asp-append-version="true"></script>
}