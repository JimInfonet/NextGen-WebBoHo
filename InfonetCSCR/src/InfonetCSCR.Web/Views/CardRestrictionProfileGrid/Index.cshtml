@section Head {
  <link href="~/css/cardRestrictionProfileGrid.css" rel="stylesheet" asp-append-version="true" />
}

@inject IViewLocalizer localizer

@{
  ViewData["Title"] = @localizer["cardRestrictionProfiles"];
}

<input id="deleteCardRestrictionProfileTitle" type="hidden" value="@localizer["deleteCardRestrictionProfileTitle"]" />
<input id="deleteCardRestrictionProfileMessage" type="hidden" value="@localizer["deleteCardRestrictionProfileMessage", "{0}"]" />
<input id="cardRestrictionProfileDeletedSuccessfully" type="hidden" value="@localizer["cardRestrictionProfileDeletedSuccessfully"]" />
<input id="yes" type="hidden" value="@localizer["yes"]" />
<input id="no" type="hidden" value="@localizer["no"]" />

<div class="p-3 mt-2 d-flex justify-content-between">
  <h3 class="h3 fw-bold mb-3">
    @(localizer["cardRestrictionProfiles"])
  </h3>
</div>

<div class="m-3">
  <div class=" body-content p-2">
    <div class="container" style="max-width:3000px;">
      <table id="card-restriction-profile-grid" class="table table-striped" width="20%">
        <thead>
          <tr>
            <th width="35%">@localizer["profileId"]</th>
            <th width="35%">@localizer["profileName"]</th>
            <th width="30%">@localizer["restrictProducts"]</th>
          </tr>
        </thead>
        <tfoot>
          <tr>
            <th class="input substring-search" width="35%" scope="col"></th>
            <th class="input substring-search" width="35%" scope="col"></th>
            <th class="input substring-search" width="30%" scope="col" hidden></th>
          </tr>
        </tfoot>
      </table>
    </div>

    <div class="d-flex justify-content-between gap-3 footer-btns">
      <div class="d-flex gap-3">
        <button id="btn-add" type="button" class="btn btn-footer btn-primary text-center align-items-center" onclick="onCardProfileAddClick()">@localizer["add"]</button>
        <button id="btn-edit" type="button" class="btn btn-footer btn-primary text-center align-items-center" onclick="onCardProfileEditClick()">@localizer["edit"]</button>
        <button id="btn-delete" type="button" class="btn btn-footer btn-danger text-center align-items-center" onclick="onCardProfileDeleteClick()">@localizer["delete"]</button>
        <button id="btn-copy" type="button" class="btn btn-footer btn-copy btn-primary text-center align-items-center" onclick="copyRestrictionProfile()">@localizer["copy"]</button>
      </div>
      <div class="d-flex gap-3 product-restriction-btn">
        <button id="btn-product-restriction" onclick="goToProductRestrictionPage()" type="button" class="btn btn-product-restriction text-center align-items-center">@localizer["productRestriction"]</button>
      </div>
    </div>
  </div>
</div>

@section Scripts
{
  <script src="~/js/cardRestrictionProfileGrid.js" asp-append-version="true"></script>
}
